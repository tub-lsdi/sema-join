LOG_LEVEL="e.g. DEBUG, INFO, WARNING, ERROR"

DB_PATH="path/to/duckdb/database.db"
DUCKDB_TEMP_DIRECTORY="path/to/duckdb/temp_directory there should be many GBs of free space for large operations"
DUCKDB_MEMORY_LIMIT="e.g. 75% of available system memory, such as '12GB' or '24GB'"
TEMP_META_DIR_NAME="directory_name_for_temporary_parquet_metadata"
TEMP_CELLS_DIR_NAME="directory_name_for_temporary_parquet_cells"
NUM_WORKERS_FOR_CALCULATION="number_of_parallel_workers_to_use_for_calculation, e.g. '4', depends_on_CPU_cores_and_memory"

CELL_BATCH_SIZE="how often to write intermediary results, depends on memory, e.g. '1_000_000'"
TABLE_BATCH_SIZE="how often to write intermediary results, depends on memory, e.g. '50_000'"
TABLES_PER_WORKER_BATCH="how many tables each worker processes during the calculation for CS per batch, e.g. '40'"

# Ollama AI Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="mistral"
OLLAMA_TIMEOUT="60"
